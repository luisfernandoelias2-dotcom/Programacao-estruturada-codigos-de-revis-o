#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char nome[50];
    int codigo;
    int carga_horaria;
} Disciplina;

typedef struct {
    char nome[100];
    float notas[4];
    int ra;
    Disciplina disciplina;
    float media;
    char status[20];
} Alunos;

Alunos *alunos = NULL;
int quant = 0;

void sistema_academico ( ){
printf ("SISTEMA ACADEMICO BRAWL STARS");
}

Alunos *buscar_aluno(Alunos *a, int n, int ra) {
      int i;

    for (i = 0; i < n; i++) {
        if ((a + i)->ra == ra) {
            return (a + i);
        }
    }

    return NULL;
}

void calcular_media(Alunos *a) {
    float soma = 0;
    int i;

    for (i = 0; i < 4; i++) {
        soma += a->notas[i];
    }

    a->media = soma / 4;

    if (a->media >= 5.0) {
        printf("Status: Aprovado!\n");
    } 
	else {
        printf("Status: Reprovado!\n");
    }
}


void cadastrarAluno() {
    Alunos *cont;

    cont = realloc(alunos, (quant + 1) * sizeof(Alunos));

    if (cont == NULL) {
        printf("Erro ao alocar memoria!\n");
        return;
    }

    alunos = cont;

    Alunos *a = &alunos[quant];

    printf("\n===== CADASTRO DE ALUNO =====\n");

    printf("Nome: ");
    scanf("%s", a->nome);

    printf("RA: ");
    scanf("%d", &a->ra);

    printf("\n===== DISCIPLINA =====\n");

    printf("Nome da disciplina: ");
    scanf("%s", a->disciplina.nome);

    printf("Codigo da disciplina: ");
    scanf("%d", &a->disciplina.codigo);

    printf("Carga horaria: ");
    scanf("%d", &a->disciplina.carga_horaria);

    printf("\n===== NOTAS =====\n");

    for (int i = 0; i < 4; i++) {
        printf("Nota %d: ", i + 1);
        scanf("%f", &a->notas[i]);
    }

    calcular_media(a);

    quant++;

    printf("\nAluno cadastrado com sucesso!\n");
}
